{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decidering",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decidering",
      // replace after `wrangler d1 create decidering`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Tracker", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "POST_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
