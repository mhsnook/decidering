{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decidering",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decidering",
      "database_id": "196b0b5b-2356-49fe-8915-4d49f3710260",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Tracker", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "POST_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true },
  // Previews inherit none of the bindings above. One the Worker reads from `env`
  // and that is missing here is undefined at runtime, not a build error.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "decidering-preview",
        "database_id": "08ea785b-bbd6-45c2-925b-3bf403e597df"
      }
    ],
    "durable_objects": {
      "bindings": [{ "name": "Tracker", "class_name": "Tracker" }]
    },
    "ai": { "binding": "AI" },
    "ratelimits": [{ "name": "POST_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }]
  }
}
