{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sporelight",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sporelight",
      "database_id": "bd8981d0-61c6-48e6-8241-25335083f225",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Tracker", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  "ai": { "binding": "AI" },
  // The AI Gateway the news search and the article reader bill through. Only a
  // gateway named `default` is created on first use; this one has to exist.
  "vars": { "AI_GATEWAY": "sporelight" },
  "ratelimits": [{ "name": "POST_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  "triggers": { "crons": ["17 14 * * *"] },
  "observability": { "enabled": true },
  // Previews inherit none of the bindings above. One the Worker reads from `env`
  // and that is missing here is undefined at runtime, not a build error.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sporelight-preview",
        "database_id": "14c5e7ec-779b-44ab-913d-e6c7fa7574f6"
      }
    ],
    "durable_objects": {
      "bindings": [{ "name": "Tracker", "class_name": "Tracker" }]
    },
    "ai": { "binding": "AI" },
    "vars": { "AI_GATEWAY": "sporelight" },
    "ratelimits": [{ "name": "POST_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }]
  }
}
