// Only for `wrangler d1` commands against the database Previews share (see the
// `previews` block in wrangler.jsonc). Nothing deploys from this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sporelight",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sporelight-preview",
      "database_id": "14c5e7ec-779b-44ab-913d-e6c7fa7574f6",
      "migrations_dir": "migrations"
    }
  ]
}
